// Introspected from the existing database with `prisma db pull`, then renamed for clean
// TypeScript names. Physical table/column/index/FK names are preserved via @@map / @map / map:.
//
// This schema is NEVER used to migrate the database. Do not run `prisma migrate` or
// `prisma db push` against it. After any DB change, re-run `prisma db pull` and re-apply names.
//
// Type notes (MySQL -> Prisma):
//   int/smallint/tinyint UNSIGNED -> Int (all current values fit in a signed 32-bit int)
//   tinyint(1)                    -> Boolean (categories.is_banned)
//   enum columns                  -> Prisma enums (MySQL enums are inline; names are TS-only)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  email        String    @unique(map: "uq_admin_email") @db.VarChar(190)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String?   @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamp(0)

  @@map("admins")
}

model Sura {
  number          Int              @id @db.UnsignedSmallInt
  nameAr          String           @map("name_ar") @db.VarChar(60)
  nameEn          String           @map("name_en") @db.VarChar(60)
  ayahCount       Int              @map("ayah_count") @db.UnsignedSmallInt
  revelationPlace RevelationPlace? @map("revelation_place")
  ayahs           Ayah[]

  @@map("suras")
}

model Ayah {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  suraNumber    Int            @map("sura_number") @db.UnsignedSmallInt
  ayahNumber    Int            @map("ayah_number") @db.UnsignedSmallInt
  textUthmani   String         @map("text_uthmani") @db.Text
  textSimple    String?        @map("text_simple") @db.Text
  juz           Int?           @db.UnsignedTinyInt
  hizb          Int?           @db.UnsignedTinyInt
  rubElHizb     Int?           @map("rub_el_hizb") @db.UnsignedSmallInt
  page          Int?           @db.UnsignedSmallInt
  sajdaType     SajdaType?     @map("sajda_type")
  sajdaNumber   Int?           @map("sajda_number") @db.UnsignedTinyInt
  sortByNuzul   Int?           @map("sort_by_nuzul") @db.UnsignedSmallInt
  sura          Sura           @relation(fields: [suraNumber], references: [number], onDelete: NoAction, map: "fk_ayahs_sura")
  categoryLinks CategoryAyah[]
  tafsirs       Tafsir[]

  @@unique([suraNumber, ayahNumber], map: "uq_sura_ayah")
  @@index([juz], map: "idx_juz")
  @@index([page], map: "idx_page")
  @@fulltext([textSimple], map: "ft_text_simple")
  @@map("ayahs")
}

/// Topics. Rows with isBanned = true must never be returned by public endpoints.
/// legacyUuid and titleRaw are internal and must never appear in public responses.
model Category {
  id          Int            @id @default(autoincrement()) @db.UnsignedInt
  legacyUuid  String?        @unique(map: "uq_legacy_uuid") @map("legacy_uuid") @db.Char(36)
  parentId    Int?           @map("parent_id") @db.UnsignedInt
  title       String         @db.VarChar(255)
  titleRaw    String?        @map("title_raw") @db.VarChar(255)
  description String?        @db.Text
  isBanned    Boolean        @default(false) @map("is_banned")
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id], map: "fk_categories_parent")
  children    Category[]     @relation("CategoryTree")
  ayahLinks   CategoryAyah[]

  @@index([isBanned], map: "idx_is_banned")
  @@index([parentId], map: "idx_parent")
  @@map("categories")
}

model CategoryAyah {
  categoryId Int      @map("category_id") @db.UnsignedInt
  ayahId     Int      @map("ayah_id") @db.UnsignedInt
  ayah       Ayah     @relation(fields: [ayahId], references: [id], onDelete: Cascade, map: "fk_ca_ayah")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "fk_ca_category")

  @@id([categoryId, ayahId])
  @@index([ayahId], map: "idx_ayah")
  @@map("category_ayah")
}

/// ids 0, 2, 3, 4 are placeholders and must not be exposed until confirmed.
model TafsirBook {
  id      Int      @id @db.UnsignedTinyInt
  name    String   @db.VarChar(100)
  author  String?  @db.VarChar(150)
  tafsirs Tafsir[]

  @@map("tafsir_books")
}

/// content is large (mediumtext): select it ONLY in GET /tafsirs?ayah_id=, never in lists.
model Tafsir {
  id      Int        @id @default(autoincrement()) @db.UnsignedInt
  ayahId  Int        @map("ayah_id") @db.UnsignedInt
  bookId  Int        @map("book_id") @db.UnsignedTinyInt
  content String?    @db.MediumText
  ayah    Ayah       @relation(fields: [ayahId], references: [id], onDelete: Cascade, map: "fk_tafsir_ayah")
  book    TafsirBook @relation(fields: [bookId], references: [id], onDelete: NoAction, map: "fk_tafsir_book")

  @@unique([ayahId, bookId], map: "uq_ayah_book")
  @@index([bookId], map: "idx_book")
  @@map("tafsirs")
}

enum RevelationPlace {
  mecca
  medina

  @@map("suras_revelation_place")
}

enum SajdaType {
  optional
  required

  @@map("ayahs_sajda_type")
}

// ---------------------------------------------------------------------------------------------
// Quran audio (AlQuran Cloud). ADDITIVE tables created by prisma/sql/001_quran_audio.sql
// (npm run db:migrate:audio). They reference ayahs.id but no field was added to Ayah/Sura:
// the existing models and tables are unchanged.
// ---------------------------------------------------------------------------------------------

/// One AlQuran Cloud audio edition. bitrate is NULL until the CDN URL pattern is verified.
model AudioReciter {
  id                Int         @id @default(autoincrement()) @db.UnsignedInt
  identifier        String      @unique(map: "uq_reciter_identifier") @db.VarChar(64)
  name              String      @db.VarChar(150)
  englishName       String?     @map("english_name") @db.VarChar(150)
  language          String      @db.VarChar(10)
  format            String      @db.VarChar(20)
  type              String      @db.VarChar(30)
  bitrate           Int?        @db.UnsignedSmallInt
  secondaryBitrates String?     @map("secondary_bitrates") @db.VarChar(60)
  isAvailable       Boolean     @default(true) @map("is_available")
  isActive          Boolean     @default(true) @map("is_active")
  verifiedAt        DateTime?   @map("verified_at") @db.Timestamp(0)
  verificationError String?     @map("verification_error") @db.VarChar(255)
  lastSyncedAt      DateTime?   @map("last_synced_at") @db.Timestamp(0)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  audio             AyahAudio[]

  @@map("audio_reciters")
}

/// Verified audio reference for one (reciter, ayah). ayahId -> ayahs.id (FK fk_aa_ayah, SQL only).
model AyahAudio {
  id           Int             @id @default(autoincrement()) @db.UnsignedInt
  reciterId    Int             @map("reciter_id") @db.UnsignedInt
  ayahId       Int             @map("ayah_id") @db.UnsignedInt
  globalNumber Int             @map("global_number") @db.UnsignedSmallInt
  status       AyahAudioStatus
  url          String?         @db.VarChar(255)
  bitrate      Int?            @db.UnsignedSmallInt
  source       AyahAudioSource
  checkedAt    DateTime        @default(now()) @map("checked_at") @db.Timestamp(0)
  reciter      AudioReciter    @relation(fields: [reciterId], references: [id], onDelete: Cascade, map: "fk_aa_reciter")

  @@unique([reciterId, ayahId], map: "uq_reciter_ayah")
  @@index([ayahId], map: "idx_aa_ayah")
  @@index([reciterId, status], map: "idx_aa_reciter_status")
  @@map("ayah_audio")
}

model AudioSyncJob {
  id              Int                @id @default(autoincrement()) @db.UnsignedInt
  kind            AudioSyncJobKind
  status          AudioSyncJobStatus
  recitersTotal   Int                @default(0) @map("reciters_total") @db.UnsignedSmallInt
  recitersDone    Int                @default(0) @map("reciters_done") @db.UnsignedSmallInt
  currentReciter  String?            @map("current_reciter") @db.VarChar(64)
  itemsTotal      Int                @default(0) @map("items_total") @db.UnsignedInt
  itemsDone       Int                @default(0) @map("items_done") @db.UnsignedInt
  missingCount    Int                @default(0) @map("missing_count") @db.UnsignedInt
  errorCount      Int                @default(0) @map("error_count") @db.UnsignedInt
  pendingReciters String?            @map("pending_reciters") @db.Text
  cursorAyahId    Int?               @map("cursor_ayah_id") @db.UnsignedInt
  errors          String?            @db.Text
  startedAt       DateTime           @default(now()) @map("started_at") @db.Timestamp(0)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  finishedAt      DateTime?          @map("finished_at") @db.Timestamp(0)

  @@index([kind, status], map: "idx_job_kind_status")
  @@map("audio_sync_jobs")
}

enum AyahAudioStatus {
  available
  missing

  @@map("ayah_audio_status")
}

enum AyahAudioSource {
  cdn_listing
  api

  @@map("ayah_audio_source")
}

enum AudioSyncJobKind {
  reciters
  audio

  @@map("audio_sync_jobs_kind")
}

enum AudioSyncJobStatus {
  running
  completed
  failed
  interrupted

  @@map("audio_sync_jobs_status")
}

/// Full-sura recordings (one MP3 per sura), from prisma/sql/002_quran_audio_surah.sql.
/// SEPARATE from AudioReciter (verse-by-verse): different CDN folders. identifier = CDN folder.
model AudioSurahReciter {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  identifier    String    @unique(map: "uq_surah_reciter_identifier") @db.VarChar(80)
  apiIdentifier String?   @map("api_identifier") @db.VarChar(80)
  name          String?   @db.VarChar(150)
  englishName   String?   @map("english_name") @db.VarChar(150)
  language      String    @db.VarChar(10)
  bitrate       Int       @db.UnsignedSmallInt
  bitrates      String    @db.VarChar(60)
  surahCount    Int       @map("surah_count") @db.UnsignedSmallInt
  missingSurahs String?   @map("missing_surahs") @db.VarChar(500)
  isAvailable   Boolean   @default(true) @map("is_available")
  isActive      Boolean   @default(true) @map("is_active")
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamp(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("audio_surah_reciters")
}
