# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3001
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# Comma-separated exact origins allowed by CORS (scheme + host [+ port], no trailing slash).
WEB_ORIGIN=http://localhost:3000

# Express "trust proxy": false (no proxy), 1 (one reverse proxy in front: recommended in prod),
# or a list like "loopback, 10.0.0.0/8". Avoid "true": clients could spoof their IP.
TRUST_PROXY=false

# Request size protection
BODY_LIMIT=100kb
MAX_URL_LENGTH=8192

# Rate limits (requests per window per client IP)
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_SEARCH_LIMIT=30
THROTTLE_SEARCH_TTL_SECONDS=60

# Admin sessions (JWT in an httpOnly cookie). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# Only read by `npm run seed:admin` (scripts/seed-admin.ts), never by the API.
# Remove them from .env after seeding. Password: at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=
